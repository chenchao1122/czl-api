+You should have received a copy of the GNU Affero General Public License
+along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+For commercial licensing, please contact support@quantumnous.com
+*/
+import type { PricingModel } from '@/features/pricing/types'
+
+const FEATURED_MODEL_NAMES = ['sd-fast-720', 'seedream-5-pro', 'gpt-image-2']
+
+function normalizeModelName(name: string): string {
+  return name.toLowerCase().replaceAll(/[\s_]+/g, '-')
+}
+
+export function selectFeaturedModels(models: PricingModel[]): PricingModel[] {
+  const selected = FEATURED_MODEL_NAMES.flatMap((needle) => {
+    const match = models.find((model) =>
+      normalizeModelName(model.model_name).includes(needle)
+    )
+    return match ? [match] : []
+  })
+
+  for (const model of models) {
+    if (selected.length >= 3) break
+    if (!selected.some((item) => item.model_name === model.model_name)) {
+      selected.push(model)
+    }
+  }
+
+  return selected.slice(0, 3)
+}
