+import { describe, expect, it } from 'vitest'
+
+import type { PricingModel } from '@/features/pricing/types'
+
+import { selectFeaturedModels } from '../lib/featured-models'
+
+function model(modelName: string): PricingModel {
+  return {
+    id: modelName.length,
+    model_name: modelName,
+    quota_type: 1,
+    model_ratio: 1,
+    completion_ratio: 1,
+    enable_groups: [],
+  }
+}
+
+describe('selectFeaturedModels', () => {
+  it('prioritizes the configured video, image, and text showcase models', () => {
+    const result = selectFeaturedModels([
+      model('gpt-4o-mini'),
+      model('gpt-image-2'),
+      model('SD-fast-720'),
+      model('Seedream 5 Pro'),
+    ])
+
+    expect(result.map((item) => item.model_name)).toEqual([
+      'SD-fast-720',
+      'Seedream 5 Pro',
+      'gpt-image-2',
+    ])
+  })
+
+  it('fills missing showcase models with unique live catalog entries', () => {
+    const result = selectFeaturedModels([
+      model('SD-fast-720'),
+      model('chat-model'),
+      model('image-model'),
+      model('extra-model'),
+    ])
+
+    expect(result.map((item) => item.model_name)).toEqual([
+      'SD-fast-720',
+      'chat-model',
+      'image-model',
+    ])
+  })
+})
