+type qsTestTransport func(*http.Request) (*http.Response, error)
+
+func (transport qsTestTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	return transport(req)
+}
+
+func TestQSWANRelaySubmissionAndWallet(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	sqlDB.SetMaxOpenConns(1)
+	previousDB := model.DB
+	redisEnabled, batchEnabled := common.RedisEnabled, common.BatchUpdateEnabled
+	model.DB = db
+	common.RedisEnabled, common.BatchUpdateEnabled = false, false
+	t.Cleanup(func() {
+		model.DB = previousDB
+		common.RedisEnabled, common.BatchUpdateEnabled = redisEnabled, batchEnabled
+		assert.NoError(t, sqlDB.Close())
+	})
+	require.NoError(t, db.AutoMigrate(&model.User{}, &model.Token{}))
+
+	previousPrices, err := common.Marshal(ratio_setting.GetModelPriceCopy())
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		assert.NoError(t, ratio_setting.UpdateModelPriceByJSONString(string(previousPrices)))
+	})
+	require.NoError(t, ratio_setting.UpdateModelPriceByJSONString(`{"qs-test-alias":0.24}`))
+	client, err := service.GetHttpClientWithProxy("")
+	require.NoError(t, err)
+	previousTransport := client.Transport
+	t.Cleanup(func() { client.Transport = previousTransport })
+
+	previousGroups, err := common.Marshal(ratio_setting.GetGroupRatioCopy())
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		assert.NoError(t, ratio_setting.UpdateGroupRatioByJSONString(string(previousGroups)))
+	})
+	require.NoError(t, ratio_setting.UpdateGroupRatioByJSONString(`{"qs-test-group":1.25}`))
+
+	for i, tc := range []struct {
+		label, fields, upstreamStatus, outboundSeconds string
+		quota, wallet, token                           int
+		wantError                                      string
+	}{
+		{"default reserves 15 seconds", "", "processing", "15", 2250000, 5000000, 5000000, ""},
+		{"10 seconds reserves exactly once", `,"seconds":"10"`, "processing", "10", 1500000, 5000000, 5000000, ""},
+		{"30 seconds reserves exactly once", `,"duration":30`, "processing", "30", 4500000, 5000000, 5000000, ""},
+		{"invalid duration never reaches upstream", `,"seconds":"9"`, "", "", 0, 5000000, 5000000, "invalid_seconds"},
+		{"insufficient wallet never reaches upstream", `,"seconds":"10"`, "", "", 0, 1000000, 5000000, "insufficient_user_quota"},
+		{"insufficient token never reaches upstream", `,"seconds":"10"`, "", "", 0, 5000000, 1000000, "pre_consume_token_quota_failed"},
+		{"terminal failure refunds the full reserve", `,"seconds":"10"`, "failed", "10", 1500000, 5000000, 5000000, "upstream_video_failed"},
+	} {
+		t.Run(tc.label, func(t *testing.T) {
+			user := model.User{Id: i + 1, Username: "qs-wallet-" + string(rune('a'+i)), Quota: tc.wallet, Status: common.UserStatusEnabled, AffCode: string(rune(97 + i))}
+			token := model.Token{Id: i + 1, UserId: user.Id, Key: "qs-token-" + string(rune('a'+i)), RemainQuota: tc.token, Status: common.TokenStatusEnabled}
+			require.NoError(t, db.Create(&user).Error)
+			require.NoError(t, db.Create(&token).Error)
+			calls := 0
+			balances := func() (int, int) {
+				var u model.User
+				var k model.Token
+				require.NoError(t, db.First(&u, user.Id).Error)
+				require.NoError(t, db.First(&k, token.Id).Error)
+				return u.Quota, k.RemainQuota
+			}
+
+			client.Transport = qsTestTransport(func(req *http.Request) (*http.Response, error) {
+				calls++
+				assert.Equal(t, "https://qsqs.org/v1/videos", req.URL.String())
+				assert.Equal(t, "Bearer isolated-upstream-key", req.Header.Get("Authorization"))
+				payload, readErr := io.ReadAll(req.Body)
+				require.NoError(t, readErr)
+				var body map[string]any
+				require.NoError(t, common.Unmarshal(payload, &body))
+				assert.Equal(t, "wan-3.0-per-second", body["model"])
+				assert.Equal(t, tc.outboundSeconds, body["seconds"])
+				assert.NotContains(t, body, "duration")
+				w, k := balances()
+				assert.Equal(t, tc.wallet-tc.quota, w, "wallet before sending")
+				assert.Equal(t, tc.token-tc.quota, k, "token before sending")
+				resp := `{"id":"qs-upstream-private","status":"` + tc.upstreamStatus + `"}`
+				if tc.upstreamStatus == "failed" {
+					resp = `{"id":"qs-upstream-private","status":"failed","error":"render rejected"}`
+				}
+				return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(resp)), Header: make(http.Header)}, nil
+			})
+
+			rec := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(rec)
+			c.Request = httptest.NewRequest(http.MethodPost, "/v1/videos", strings.NewReader(`{"model":"qs-test-alias","prompt":"paper boat"`+tc.fields+`}`))
+			c.Request.Header.Set("Content-Type", "application/json")
+			t.Cleanup(func() { common.CleanupBodyStorage(c) })
+			common.SetContextKey(c, constant.ContextKeyChannelType, constant.ChannelTypeOpenAI)
+			common.SetContextKey(c, constant.ContextKeyChannelBaseUrl, "https://qsqs.org")
+			common.SetContextKey(c, constant.ContextKeyChannelKey, "isolated-upstream-key")
+			c.Set("model_mapping", `{"qs-test-alias":"wan-3.0-per-second"}`)
+			info := &relaycommon.RelayInfo{
+				UserId: user.Id, TokenId: token.Id, TokenKey: token.Key,
+				UsingGroup: "qs-test-group", UserGroup: "default", OriginModelName: "qs-test-alias",
+				UserSetting:   dto.UserSetting{BillingPreference: "wallet_only"},
+				TaskRelayInfo: &relaycommon.TaskRelayInfo{},
+			}
+			result, taskErr := RelayTaskSubmit(c, info)
+			if tc.wantError == "" {
+				require.Nil(t, taskErr)
+				require.NotNil(t, result)
+				assert.Equal(t, tc.quota, result.Quota)
+				assert.Equal(t, 1, calls)
+				assert.Equal(t, "qs-upstream-private", result.UpstreamTaskID)
+				assert.NotContains(t, rec.Body.String(), result.UpstreamTaskID)
+				require.NoError(t, service.SettleBilling(c, info, result.Quota))
+			} else {
+				require.NotNil(t, taskErr)
+				assert.Equal(t, tc.wantError, taskErr.Code)
+				assert.Nil(t, result)
+				if tc.upstreamStatus == "failed" {
+					assert.Equal(t, 1, calls)
+					assert.Equal(t, "render rejected", taskErr.Message)
+					// Exercise the same billing refund the controller invokes on a submit error.
+					require.NotNil(t, info.Billing)
+					info.Billing.Refund(c)
+					require.Eventually(t, func() bool {
+						w, k := balances()
+						return w == tc.wallet && k == tc.token
+					}, time.Second, 5*time.Millisecond)
+				} else {
+					assert.Zero(t, calls)
+				}
+			}
+			w, k := balances()
+			if tc.wantError == "" {
+				assert.Equal(t, tc.wallet-tc.quota, w)
+				assert.Equal(t, tc.token-tc.quota, k)
+			} else {
+				assert.Equal(t, tc.wallet, w)
+				assert.Equal(t, tc.token, k)
+			}
+		})
+	}
+}
