+func TestQSWANTerminalSubmissionFailureDoesNotRetry(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	err := &taskdto.TaskError{Code: "upstream_video_failed", StatusCode: http.StatusBadGateway}
+	assert.False(t, shouldRetryTaskRelay(c, 25, err, 2))
+}
